
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(data) {
      return signedIn() && data.userId == request.auth.uid;
    }

    function isText(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    function isValidStudy(data) {
      return isOwner(data)
        && data.createdAt is timestamp
        && data.type in ['tutor', 'summaries', 'flashcards', 'quizzes']
        && (
          (
            data.type == 'tutor'
            && data.keys().hasOnly(['userId', 'type', 'topic', 'messages', 'createdAt'])
            && isText(data.topic, 1, 120)
            && data.messages is list
            && data.messages.size() <= 80
          )
          || (
            data.type == 'summaries'
            && data.keys().hasOnly(['userId', 'type', 'notes', 'summary', 'createdAt'])
            && isText(data.notes, 10, 20000)
            && isText(data.summary, 1, 8000)
          )
          || (
            data.type == 'flashcards'
            && data.keys().hasOnly(['userId', 'type', 'topic', 'flashcards', 'createdAt'])
            && isText(data.topic, 2, 120)
            && data.flashcards is list
            && data.flashcards.size() >= 1
            && data.flashcards.size() <= 12
          )
          || (
            data.type == 'quizzes'
            && data.keys().hasOnly(['userId', 'type', 'topic', 'quiz', 'score', 'createdAt'])
            && isText(data.topic, 2, 120)
            && data.quiz is list
            && data.quiz.size() >= 1
            && data.quiz.size() <= 8
            && (!('score' in data) || data.score is string)
          )
        );
    }

    // The 'studies' collection holds all user-generated content, such as
    // tutor conversations, notes summaries, flashcards, and quizzes.
    match /studies/{studyId} {

      /**
       * ALLOW READ (get, list):
       * A user can read a document if they are signed in and their user ID
       * matches the 'userId' field stored in that document.
       * For list operations (queries), this rule is combined with a query
       * constraint on the client-side (e.g., where("userId", "==", user.uid))
       * to ensure users can only query for their own documents.
       */
      allow read: if isOwner(resource.data);

      /**
       * ALLOW CREATE:
       * A user can create a new document if they are signed in and they are
       * setting the 'userId' field to their own user ID. This ensures that
       * all new documents are correctly owned from the moment of creation.
       */
      allow create: if isValidStudy(request.resource.data);

      /**
       * ALLOW UPDATE, DELETE:
       * A user can update or delete an existing document if they are signed
       * in and their user ID matches the 'userId' field on the document
       * that is being modified. This prevents users from altering or deleting
       * each other's data.
       */
      allow update: if isOwner(resource.data) && isValidStudy(request.resource.data);
      allow delete: if isOwner(resource.data);
    }

    // The 'users' collection stores public-facing profile information for each user.
    match /users/{userId} {
       /**
       * ALLOW READ:
       * A user can read their own profile document. The app currently stores profile
       * data in Firebase Auth, so this collection is reserved for future profile fields.
       */
      allow read: if signedIn() && request.auth.uid == userId;

      /**
       * ALLOW CREATE, UPDATE:
       * A user can create or update their own profile document. The {userId} wildcard
       * must match the UID of the authenticated user. This prevents users from
       * creating or modifying profiles for other users.
       */
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'photoURL', 'updatedAt'])
        && (!('displayName' in request.resource.data) || request.resource.data.displayName is string)
        && (!('email' in request.resource.data) || request.resource.data.email is string)
        && (!('photoURL' in request.resource.data) || request.resource.data.photoURL is string)
        && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is timestamp);

       /**
       * ALLOW DELETE:
       * Deleting user profile documents is disallowed to prevent accidental data loss.
       * User deletion should be handled by a more robust, backend-driven process.
       */
      allow delete: if false;
    }
  }
}
